{
  "name": "potlatch-club-desktop",
  "productName": "Potlatch Club",
  "version": "1.0.0",
  "description": "Potlatch Club kitchen and staff management: desktop app",
  "main": "main.js",
  "author": "The Potlatch Club",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "club.potlatch.desktop",
    "productName": "Potlatch Club",
    "files": ["main.js", "preload.js", "setup.html", "offline.html", "build/logo.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true },
    "mac": { "target": "dmg", "icon": "build/icon.png", "category": "public.app-category.business" }
  }
}
